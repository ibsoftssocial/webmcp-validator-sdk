{
  "name": "@webmcp-validator/core",
  "version": "0.1.1",
  "description": "Core engine, types, validator, and scoring for WebMCP",
  "author": "ibsoftssocial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibsoftssocial/webmcp-validator-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://webmcpworld.com",
  "bugs": {
    "url": "https://github.com/ibsoftssocial/webmcp-validator-sdk/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "validator",
    "linter",
    "ai-readiness",
    "playwright",
