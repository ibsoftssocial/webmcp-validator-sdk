{
  "name": "webmcp-validator-sdk",
  "version": "0.1.0",
  "description": "TypeScript/Node.js SDK to scan, audit, and validate WebMCP implementations",
  "author": "ibsoftssocial",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibsoftssocial/webmcp-validator-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://webmcpworld.com",
  "bugs": {
    "url": "https://github.com/ibsoftssocial/webmcp-validator-sdk/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "sdk",
    "ai-agents",
    "ai-readiness",
    "validator",
    "typescript",
    "node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@webmcp-validator/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
